  name = Arthur Satarov
  email = asv.webdev@gmail.com

[core]
  editor = nvim           # Set default editor

[init]
  defaultBranch = main

[push]
  default = current       # Make `git push` automatically push relevant
  followTags = true       # Make `git push` push relevant annotated tags when pushing branches out

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Рабочие репозитории — рабочая почта
[includeIf "gitdir/i:~/code/adm/"]
  path = ~/.config/git/work
