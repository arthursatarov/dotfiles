{
  // #########################################
  // Text Editor
  // #########################################
  "editor.accessibilitySupport": "off",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.lineNumbers": "relative",
  "editor.linkedEditing": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.tabSize": 2,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 90,
  "editor.inlayHints.enabled": "offUnlessPressed",

  // Terminal
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono'",

  // Cursor
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",

  // Font
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono'",
  "editor.lineHeight": 22,
  "editor.fontWeight": "500",
  "editor.fontLigatures": true,

  // Formatting
  "editor.formatOnPaste": false,
  "editor.formatOnSave": false,

  // Minimap
  "editor.minimap.enabled": false,

  // Exclude files & folders
  "files.exclude": {},

  // #########################################
  // Workbench
  // #########################################
  "workbench.startupEditor": "none",
  "workbench.productIconTheme": "viraUIIcons",

  // Appearance
  "workbench.activityBar.location": "top",
  "workbench.iconTheme": "vira-icons-carbon",

  // Breadcrumbs
  "breadcrumbs.enabled": false,

  // #########################################
  // Window
  // #########################################
  "window.menuBarVisibility": "compact",

  // #########################################
  // Features
  // #########################################

  // Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,

  // #########################################
  // Extensions
  // #########################################
  "extensions.ignoreRecommendations": true,

  // #########################################
  // Vim
  // #########################################
  "vim.leader": "<space>",
  "vim.easymotion": true,
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.hlsearch": true,
  "vim.useCtrlKeys": true,
  "vim.handleKeys": {
    "<C-p>": false,
    "<C-d>": false
  },

  // Cursor Styles Per Mode
  "vim.cursorStylePerMode.insert": "line",
  "vim.cursorStylePerMode.normal": "block",
  "vim.cursorStylePerMode.visual": "block-outline",

  // To improve performance
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },

  "vim.normalModeKeyBindings": [
    // Bind ctrl+n to turn off search highlighting
    {
      "before": ["<C-n>"],
      "commands": [":nohl"]
    }
  ],

  // Normal Mode Keybindings
  "vim.normalModeKeyBindingsNonRecursive": [
    // Save & close files
    { "before": ["leader", "w"], "commands": [":w!"] },
    { "before": ["leader", "q"], "commands": [":q!"] },
    { "before": ["leader", "x"], "commands": [":x!"] },

    // Quick open
    {
      "before": ["leader", "f"],
      "commands": ["workbench.action.showAllEditors"]
    },
    {
      "before": ["leader", "F"],
      "commands": ["workbench.action.quickOpen"]
    },

    // Quick Fix
    {
      "before": ["leader", "c", "a"],
      "commands": ["editor.action.quickFix"]
    },

    // Switch b/w tabs
    { "before": ["<S-h>"], "commands": [":bprevious"] },
    { "before": ["<S-l>"], "commands": [":bnext"] },

    // Splits
    { "before": ["leader", "v"], "commands": [":vsplit"] },
    { "before": ["leader", "s"], "commands": [":split"] }
  ],

  // Insert Mode Keybindings
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "j"],
      "after": ["<Esc>"]
    },
    {
      "before": ["k", "k"],
      "after": ["<Esc>"]
    },
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],

  // Visual Mode Keybindings
  "vim.visualModeKeyBindings": [
    // Tabs indenting
    { "before": [">"], "commands": ["editor.action.indentLines"] },
    { "before": ["<"], "commands": ["editor.action.outdentLines"] },

    // Move selected lines
    { "before": ["J"], "commands": ["editor.action.moveLinesDownAction"] },
    { "before": ["K"], "commands": ["editor.action.moveLinesUpAction"] },

    // Toggle comments
    { "before": ["leader", "c"], "commands": ["editor.action.commentLine"] }
  ],

  // #########################################
  // CSS, SCSS & Stylelint
  // #########################################
  "css.format.enable": false,
  "less.format.enable": false,
  "scss.format.enable": false,
  "stylelint.validate": ["css", "scss"],

  // #########################################
  // PHP
  // #########################################
  "intelliphp.inlineSuggestionsEnabled": false,
  "php.format.codeStyle": "WordPress",
  "php.codeActions.enabled": false,
  "[php]": {
    "editor.defaultFormatter": "DEVSENSE.phptools-vscode"
  },

  // PHP Sniffer & Beautifier
  "phpsab.standard": "WordPress",
  "phpsab.snifferEnable": true, // disable this if you don't need suggestions
  "phpsab.executablePathCBF": "${workspaceFolder}/vendor/squizlabs/php_codesniffer/bin/phpcbf",
  "phpsab.executablePathCS": "${workspaceFolder}/vendor/squizlabs/php_codesniffer/bin/phpcs",
  "phpsab.snifferShowSources": true,

  // #########################################
  // PowerShell
  // #########################################
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell"
  },

  // #########################################
  // Misc
  // #########################################

  // Telemetry
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "crash",
  "chat.commandCenter.enabled": false,

  // Code Spell Checker
  "cSpell.userWords": [
    "absint",
    "ABSPATH",
    "acfe",
    "arthursatarov",
    "atts",
    "autosync",
    "bloginfo",
    "dashicons",
    "filesize",
    "labelledby",
    "litespeed",
    "maxlength",
    "oembed",
    "phpmyadmin",
    "Polylang",
    "popperjs",
    "rootpass",
    "Satarov",
    "shortlink",
    "stylised",
    "sublink",
    "tabindex",
    "trailingslashit",
    "updraftplus",
    "wght",
    "wlwmanifest",
    "wordfence",
    "wordmark",
    "wpackagist",
    "wpcli",
    "wpengine",
    "wphead",
    "wppass",
    "wpuser",
    "yamaps",
    "ymaps",
    "Иницилиазируем",
    "кликает",
    "Скайраннинг"
  ],
  "workbench.editorAssociations": {
    "*.svg": "default"
  },
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "cSpell.language": "en,ru",
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "terminal.integrated.tabs.enabled": false,
  "workbench.colorTheme": "Vira Carbon High Contrast",
  "workbench.colorCustomizations": {
    "[Vira*]": {
      "statusBar.debuggingBackground": "#E9A58133",
      "statusBar.debuggingForeground": "#E9A581",
      "toolbar.activeBackground": "#E9A58126",
      "button.background": "#E9A581",
      "button.hoverBackground": "#E9A581cc",
      "extensionButton.separator": "#E9A58133",
      "extensionButton.background": "#E9A58114",
      "extensionButton.foreground": "#E9A581",
      "extensionButton.hoverBackground": "#E9A58133",
      "extensionButton.prominentForeground": "#E9A581",
      "extensionButton.prominentBackground": "#E9A58114",
      "extensionButton.prominentHoverBackground": "#E9A58133",
      "activityBarBadge.background": "#E9A581",
      "activityBar.activeBorder": "#E9A581",
      "activityBarTop.activeBorder": "#E9A581",
      "list.inactiveSelectionIconForeground": "#E9A581",
      "list.activeSelectionForeground": "#E9A581",
      "list.inactiveSelectionForeground": "#E9A581",
      "list.highlightForeground": "#E9A581",
      "sash.hoverBorder": "#E9A58180",
      "list.activeSelectionIconForeground": "#E9A581",
      "scrollbarSlider.activeBackground": "#E9A58180",
      "editorSuggestWidget.highlightForeground": "#E9A581",
      "textLink.foreground": "#E9A581",
      "progressBar.background": "#E9A581",
      "pickerGroup.foreground": "#E9A581",
      "tab.activeBorder": "#E9A581",
      "tab.activeBorderTop": "#E9A58100",
      "tab.unfocusedActiveBorder": "#E9A581",
      "tab.unfocusedActiveBorderTop": "#E9A58100",
      "tab.activeModifiedBorder": "#E9A58100",
      "notificationLink.foreground": "#E9A581",
      "editorWidget.resizeBorder": "#E9A581",
      "editorWidget.border": "#E9A581",
      "settings.modifiedItemIndicator": "#E9A581",
      "panelTitle.activeBorder": "#E9A581",
      "breadcrumb.activeSelectionForeground": "#E9A581",
      "menu.selectionForeground": "#E9A581",
      "menubar.selectionForeground": "#E9A581",
      "editor.findMatchBorder": "#E9A581",
      "selection.background": "#E9A58140",
      "statusBarItem.remoteBackground": "#E9A58114",
      "statusBarItem.remoteHoverBackground": "#E9A581",
      "statusBarItem.remoteForeground": "#E9A581",
      "notebook.inactiveFocusedCellBorder": "#E9A58180",
      "chat.slashCommandForeground": "#E9A581",
      "chat.avatarForeground": "#E9A581",
      "activityBarBadge.foreground": "#000000",
      "button.foreground": "#000000",
      "statusBarItem.remoteHoverForeground": "#000000",
      "extensionButton.border": "#E9A58114",
      "notebook.focusedCellBorder": "#E9A581",
      "notebook.selectedCellBorder": "#E9A581",
      "notebook.inactiveSelectedCellBorder": "#E9A58180"
    }
  },
  "editor.cursorStyle": "block",
  "viraTheme.accent": "Vira",
  "workbench.editor.editorActionsLocation": "titleBar",
  "editor.fontSize": 14,
  "claudeCode.preferredLocation": "sidebar",
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "editor.tokenColorCustomizations": {},
  "[smarty]": {
    "editor.defaultFormatter": "aswinkumar863.smarty-template-support"
  },
  "emmet.excludeLanguages": [
    "markdown",
  ],
  "emmet.includeLanguages": {
    "tpl": "html",
    "smarty": "html"
  },
  "window.commandCenter": false,
  "auto-close-tag.activationOnLanguage": [
    "xml",
    "php",
    "blade",
    "ejs",
    "jinja",
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "plaintext",
    "markdown",
    "vue",
    "liquid",
    "erb",
    "lang-cfml",
    "cfml",
    "HTML (EEx)",
    "HTML (Eex)",
    "plist"
  ],
  "[twig]": {
    "editor.defaultFormatter": "mblode.twig-language-2"
  },
  "claudeCode.hideOnboarding": true
}
